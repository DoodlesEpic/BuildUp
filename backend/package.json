{
  "name": "@buildup/backend",
  "version": "1.0.0",
  "license": "AGPL-3.0",
  "description": "A website to track notes, habits and become a better person.",
  "repository": "git@github.com:DoodlesEpic/BuildUp.git",
  "author": "Doodles <moraes.eduardo@proton.me>",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc",
    "dev": "nodemon --watch './**/*.ts' --exec 'ts-node' server.ts",
    "docs:openapi": "node scripts/generateOpenapi.cjs",
    "docs:validate": "node scripts/validateOpenapi.cjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "helmet": "^6.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.1",
    "morgan": "^1.10.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@eslint/js": "^9.39.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^18.19.130",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.11",
    "openapi-types": "^12.1.3",
    "postman-to-openapi": "^3.0.1",
    "prettier": "2.8.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@3.4.1"
}
