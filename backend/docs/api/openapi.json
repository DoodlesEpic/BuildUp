          "200": {
            "description": "Notes owned by the authenticated user.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Note"
                  }
                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/NoteList"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Notes"
        ],
        "summary": "Create note",
        "description": "Create a note owned by the authenticated user.",
        "operationId": "createNote",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteWriteRequest"
              },
              "examples": {
                "default": {
                  "$ref": "#/components/examples/NoteWriteRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Note created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/Note"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/notes/{noteId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/NoteId"
        }
      ],
      "put": {
        "tags": [
          "Notes"
        ],
        "summary": "Update note",
        "description": "Update a note owned by the authenticated user.",
        "operationId": "updateNote",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteWriteRequest"
              },
              "examples": {
                "default": {
                  "$ref": "#/components/examples/NoteWriteRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated note.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/Note"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "delete": {
        "tags": [
          "Notes"
        ],
        "summary": "Delete note",
        "description": "Delete a note owned by the authenticated user.",
        "operationId": "deleteNote",
        "responses": {
          "200": {
            "description": "Deleted note.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/Note"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/habits": {
      "get": {
        "tags": [
          "Habits"
        ],
        "summary": "List habits",
        "description": "Return habits owned by the authenticated user.",
        "operationId": "listHabits",
        "responses": {
