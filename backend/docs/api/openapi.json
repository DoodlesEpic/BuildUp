{
  "openapi": "3.0.3",
  "info": {
    "title": "BuildUp API",
    "description": "Canonical BuildUp API contract. This OpenAPI schema is the source of truth for API documentation. The Postman collection is kept as a manual testing and import companion.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Users",
      "description": "Registration, login, and current-user endpoints."
    },
    {
      "name": "Notes",
      "description": "Authenticated note CRUD endpoints."
    },
    {
      "name": "Habits",
      "description": "Authenticated habit CRUD endpoints."
    },
    {
      "name": "Habit Days",
      "description": "Authenticated endpoints for day-level habit status records."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/users": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Register user",
        "description": "Create a user account. Returns the public user fields and a JWT bearer token.",
        "operationId": "registerUser",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUserRequest"
              },
              "examples": {
                "default": {
                  "$ref": "#/components/examples/RegisterUserRequest"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/AuthResponse"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/api/users/login": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Login user",
        "description": "Authenticate a user. Returns the public user fields and a JWT bearer token.",
        "operationId": "loginUser",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginUserRequest"
              },
              "examples": {
                "default": {
                  "$ref": "#/components/examples/LoginUserRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User authenticated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/AuthResponse"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get current user",
        "description": "Return the authenticated user's public profile fields.",
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "description": "Authenticated user profile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/UserProfile"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "put": {
        "tags": [
          "Users"
        ],
        "summary": "Update current user placeholder",
        "description": "Placeholder endpoint. The current implementation returns a message and does not update persisted user fields.",
        "operationId": "updateCurrentUser",
        "responses": {
          "200": {
            "description": "Placeholder response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                },
                "example": {
                  "message": "Update user"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "delete": {
        "tags": [
          "Users"
        ],
        "summary": "Delete current user placeholder",
        "description": "Placeholder endpoint. The current implementation returns a message and does not delete the authenticated user.",
        "operationId": "deleteCurrentUser",
        "responses": {
          "200": {
            "description": "Placeholder response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                },
                "example": {
                  "message": "Delete user"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/notes": {
      "get": {
        "tags": [
          "Notes"
        ],
        "summary": "List notes",
        "description": "Return notes owned by the authenticated user, sorted by most recently updated first.",
        "operationId": "listNotes",
