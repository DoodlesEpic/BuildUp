          }
        }
      }
    },
    "/api/habits/{habitId}/habitDay": {
      "parameters": [
        {
          "$ref": "#/components/parameters/HabitId"
        }
      ],
      "get": {
        "tags": [
          "Habit Days"
        ],
        "summary": "List habit days",
        "description": "Return day-level status records for a habit owned by the authenticated user.",
        "operationId": "listHabitDays",
        "responses": {
          "200": {
            "description": "Habit days belonging to the habit.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HabitDay"
                  }
                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/HabitDayList"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Habit Days"
        ],
        "summary": "Create habit day",
        "description": "Create a day-level status record for a habit owned by the authenticated user.",
        "operationId": "createHabitDay",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HabitDayWriteRequest"
              },
              "examples": {
                "default": {
                  "$ref": "#/components/examples/HabitDayWriteRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Habit day created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HabitDay"
                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/HabitDay"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/habits/{habitId}/habitDay/{habitDayId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/HabitId"
        },
        {
          "$ref": "#/components/parameters/HabitDayId"
        }
      ],
      "put": {
        "tags": [
          "Habit Days"
        ],
        "summary": "Update habit day",
        "description": "Update a day-level status record. The current implementation returns the parent habit after saving the habit day.",
        "operationId": "updateHabitDay",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HabitDayWriteRequest"
              },
              "examples": {
                "default": {
                  "$ref": "#/components/examples/HabitDayWriteRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Parent habit for the updated habit day.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Habit"
                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/Habit"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "delete": {
        "tags": [
          "Habit Days"
        ],
        "summary": "Delete habit day",
        "description": "Delete a day-level status record from a habit owned by the authenticated user.",
        "operationId": "deleteHabitDay",
        "responses": {
          "200": {
            "description": "Deleted habit day.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HabitDay"
                },
                "examples": {
                  "default": {
                    "$ref": "#/components/examples/HabitDay"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT returned by the registration and login endpoints."
      }
    },
    "parameters": {
      "NoteId": {
        "name": "noteId",
        "in": "path",
        "required": true,
        "description": "MongoDB ObjectId for a note owned by the authenticated user.",
        "schema": {
          "$ref": "#/components/schemas/ObjectId"
        },
        "example": "66f000000000000000000101"
      },
      "HabitId": {
        "name": "habitId",
        "in": "path",
        "required": true,
        "description": "MongoDB ObjectId for a habit owned by the authenticated user.",
        "schema": {
          "$ref": "#/components/schemas/ObjectId"
        },
        "example": "66f000000000000000000201"
      },
      "HabitDayId": {
        "name": "habitDayId",
        "in": "path",
        "required": true,
        "description": "MongoDB ObjectId for a habit-day record.",
        "schema": {
          "$ref": "#/components/schemas/ObjectId"
        },
        "example": "66f000000000000000000301"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request could not be completed because validation failed or the requested resource was not found for the authenticated user.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "default": {
                "$ref": "#/components/examples/ErrorResponse"
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "The request is missing a bearer token or the bearer token is invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "default": {
                "$ref": "#/components/examples/UnauthorizedResponse"
              }
            }
          }
        }
      }
    },
    "schemas": {
      "ObjectId": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{24}$",
        "example": "66f000000000000000000001"
      },
      "DateTime": {
        "type": "string",
        "format": "date-time",
        "example": "2026-07-09T12:00:00.000Z"
      },
      "MongoVersion": {
        "type": "integer",
        "minimum": 0,
        "example": 0
      },
      "RegisterUserRequest": {
        "type": "object",
        "required": [
          "username",
          "email",
          "password"
        ],
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string",
            "example": "ada"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "correct-horse-battery-staple"
          }
        }
      },
      "LoginUserRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "correct-horse-battery-staple"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": [
          "id",
          "username",
          "email",
          "token"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ObjectId"
          },
          "username": {
            "type": "string",
            "example": "ada"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ada@example.com"
          },
          "token": {
            "type": "string",
            "description": "JWT bearer token.",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        }
      },
      "UserProfile": {
        "type": "object",
        "required": [
          "id",
          "username",
          "email"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ObjectId"
          },
          "username": {
            "type": "string",
            "example": "ada"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ada@example.com"
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "example": "Update user"
          }
        }
      },
      "NoteWriteRequest": {
        "type": "object",
        "required": [
          "title",
          "content"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "example": "Read a chapter"
          },
          "content": {
            "type": "string",
            "example": "Read chapter 3 and write a short summary."
          }
        }
      },
      "Note": {
        "type": "object",
        "required": [
          "_id",
          "user",
          "title",
          "content",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/ObjectId"
          },
          "user": {
            "$ref": "#/components/schemas/ObjectId"
          },
          "title": {
            "type": "string",
            "example": "Read a chapter"
          },
          "content": {
            "type": "string",
            "example": "Read chapter 3 and write a short summary."
          },
          "createdAt": {
            "$ref": "#/components/schemas/DateTime"
          },
          "updatedAt": {
            "$ref": "#/components/schemas/DateTime"
          },
          "__v": {
            "$ref": "#/components/schemas/MongoVersion"
          }
        }
      },
      "HabitWriteRequest": {
        "type": "object",
        "required": [
          "habitName"
        ],
        "additionalProperties": false,
        "properties": {
          "habitName": {
            "type": "string",
            "example": "Exercise"
          }
        }
      },
      "Habit": {
        "type": "object",
        "required": [
          "_id",
          "user",
          "habitName",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/ObjectId"
          },
          "user": {
            "$ref": "#/components/schemas/ObjectId"
          },
          "habitName": {
            "type": "string",
            "example": "Exercise"
          },
          "createdAt": {
            "$ref": "#/components/schemas/DateTime"
          },
          "updatedAt": {
            "$ref": "#/components/schemas/DateTime"
          },
          "__v": {
            "$ref": "#/components/schemas/MongoVersion"
          }
        }
      },
      "HabitDayWriteRequest": {
        "type": "object",
        "required": [
          "day",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "day": {
            "type": "string",
            "format": "date-time",
